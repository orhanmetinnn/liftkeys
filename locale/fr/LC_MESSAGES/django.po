#: .\crm\templates\preview\previewblog\patenkabin.html:473
msgid "kutu ebetları ve kg bekleniyor"
msgstr "Tailles de boîte attendues et kg"

#: .\crm\templates\preview\previewblog\patenkabin.html:489

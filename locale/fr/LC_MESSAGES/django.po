#: .\crm\templates\preview\previewblog\patenkabin.html:576
msgid "Paten Plastikleri"
msgstr "Plastiques pour patins"

#: .\crm\templates\preview\previewblog\patenkabin.html:584
#: .\crm\templates\preview\previewblog\patenkabin.html:586
msgid "Üst Kapak Sacı"

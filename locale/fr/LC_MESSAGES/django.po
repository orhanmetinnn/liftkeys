msgstr ""
"La clé ne doit pas être conservée dans un endroit accessible à tous, mais "
"uniquement dans une armoire verrouillée et sécurisée, connue uniquement du "
"personnel autorisé."

#: .\crm\templates\preview\previewblog\keys.html:475
msgid "Kilit Kontrolü:"
msgstr "Contrôle du verrouillage :"

#: .\crm\templates\preview\previewblog\keys.html:475

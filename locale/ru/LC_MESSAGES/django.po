msgstr "6 кВ"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:517
msgid "Yalıtım Gerilimi"
msgstr "Напряжение изоляции"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:518
msgid "500 V"
msgstr "500 В"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:524
msgid "Kontak Yapısı"
msgstr "Структура контактов"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:525

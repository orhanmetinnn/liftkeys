msgstr "Класс защиты"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:504
msgid "IP65"
msgstr "IP65"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:510
msgid "Darbe Dayanımı"
msgstr "Ударопрочность"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:511

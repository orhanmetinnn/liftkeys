msgid "Standardına Uygun"
msgstr "Соответствует стандарту"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:497
msgid "EN 60947-5-1"
msgstr "А 60947-5-1"

#: .\crm\templates\preview\previewblog\switchsistemleri.html:503
